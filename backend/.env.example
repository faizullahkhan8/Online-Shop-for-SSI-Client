# Copy to .env and supply deployment-specific values. Never commit actual secrets.
PORT=3000
FRONTEND_URL=http://localhost:5173
MONGO_URI_ONLINE=mongodb://127.0.0.1:27017/shop?replicaSet=rs0
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Exactly 32 UTF-8 bytes, generated randomly. Required when storing SMS credentials.
ENCRYPTION_KEY=
# Optional temporary old key to read existing CBC values during migration.
LEGACY_ENCRYPTION_KEY=

# Required for image uploads/deletions. No built-in account is used.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# Optional gateway credentials if not configured in admin settings.
SMS_GATE_USERNAME=
SMS_GATE_PASSWORD=

# Optional Twilio credentials. Active provider is selected in admin settings.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Optional JSON array of trusted HTTPS provider profiles. See sms-http-profiles.example.json.
# Keep profile URLs/static templates free of secrets; use encrypted admin fields or field env mappings.
SMS_HTTP_PROFILES_JSON=[]

# Separate 32-byte key encoded as 64 hex characters. Store separately from backup files.
BACKUP_KEY=
# Dedicated empty target for restore drills; never the live database.
RESTORE_MONGO_URI=
